REM **** Secondary CHW Pump 1 S/S Program
REM **** Generated by SBS Composition Engine v2 — CHW Plant
REM **** Pump starts when system enabled and pump is in lead
REM **** or system enabled and lead pump has failed

REM **** Determine out of service from output mode ****
IF SELECT( {device-name}-SCHWP1-S/S ) <> 1 THEN START {device-name}-SCHWP1-OOS ELSE STOP {device-name}-SCHWP1-OOS

REM **** Check out of service ****
IF {device-name}-SCHWP1-OOS THEN STOP {device-name}-SCHWP1-S/S , END

REM **** Check pump failure — do not restart until reset ****
IF {device-name}-SCHWP1-FAIL THEN STOP {device-name}-SCHWP1-S/S , END

REM **** Determine if pump 1 is lead or lag ****
IF {device-name}-LEAD-SCHWP < 2 THEN A = {device-name}-LEAD-SCHWP-SS
IF {device-name}-LEAD-SCHWP >= 2 THEN A = {device-name}-LAG-SCHWP-SS

REM **** Start/stop pump ****
IF A AND NOT {device-name}-SCHWP1-OOS THEN START {device-name}-SCHWP1-S/S ELSE STOP {device-name}-SCHWP1-S/S

REM **** Failure detection — SWITCH deadband on proof timing ****
B = SWITCH( B , TIME-ON( {device-name}-SCHWP1-S/S ) , 0 , {device-name}-SCHWP-STOP-DELAY )
IF B AND NOT {device-name}-SCHWP1-STS THEN START {device-name}-SCHWP1-FAIL
IF {device-name}-SCHWP1-STS THEN STOP {device-name}-SCHWP1-FAIL

REM **** Reset failure on safety reset ****
IF {device-name}-RESET-SAFETIES THEN STOP {device-name}-SCHWP1-FAIL
