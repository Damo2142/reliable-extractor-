REM **** Secondary HW Pump 3 S/S Program (Lag-2 Standby)
REM **** Generated by SBS Composition Engine v2
REM **** Lag-2 pump starts on dual failure, failover, or excess demand

REM **** Determine out of service from output mode ****
IF SELECT( {device-name}-SHWP3-S/S ) <> 1 THEN START {device-name}-SHWP3-OOS ELSE STOP {device-name}-SHWP3-OOS

REM **** Check out of service ****
IF {device-name}-SHWP3-OOS THEN STOP {device-name}-SHWP3-S/S , END

REM **** Check pump failure — do not restart until reset ****
IF {device-name}-SHWP3-FAIL THEN STOP {device-name}-SHWP3-S/S , END

REM **** START conditions for lag-2 pump ****
REM **** Condition 1: both lead and lag-1 pumps have failed ****
IF {device-name}-SHWP1-FAIL AND {device-name}-SHWP2-FAIL AND NOT {device-name}-SHWP3-OOS THEN START {device-name}-SHWP3-S/S , END

REM **** Condition 2: lead running, lag-1 failed, system still needs 2 pumps ****
IF {device-name}-LEAD-SHWP-SS AND ({device-name}-SHWP1-FAIL OR {device-name}-SHWP2-FAIL) AND {device-name}-ANY-SHWP-ON AND NOT {device-name}-SHWP3-OOS THEN START {device-name}-SHWP3-S/S , END

REM **** Condition 3: demand exceeds 2-pump capacity — DP cannot keep up ****
IF {device-name}-LEAD-SHWP-SS AND {device-name}-LAG-SHWP-SS AND {device-name}-AVG-DP < {device-name}-HWS-DP-SP - 3 AND NOT {device-name}-SHWP3-OOS THEN START {device-name}-SHWP3-S/S , END

REM **** STOP when demand drops and lag-1 is healthy ****
IF {device-name}-AVG-DP > {device-name}-HWS-DP-SP AND NOT {device-name}-SHWP1-FAIL AND NOT {device-name}-SHWP2-FAIL THEN STOP {device-name}-SHWP3-S/S

REM **** Failure detection — SWITCH deadband on proof timing ****
B = SWITCH( B , TIME-ON( {device-name}-SHWP3-S/S ) , 0 , {device-name}-HWP-STOP-DELAY )
IF B AND NOT {device-name}-SHWP3-STS THEN START {device-name}-SHWP3-FAIL
IF {device-name}-SHWP3-STS THEN STOP {device-name}-SHWP3-FAIL
IF {device-name}-RESET-SAFETIES THEN STOP {device-name}-SHWP3-FAIL
