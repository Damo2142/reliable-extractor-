10 REM ========================================
20 REM  {device-name} Direct Boiler Control
30 REM  Generated by SBS Composition Engine v2
40 REM ========================================
50 REM Staging logic based on supply temp deviation
60 DEV = {device-name}-ACT-HWS-TEMP-SP - {device-name}-HWS-T
70 {device-name}-LEAD-BLR-DEV = DEV
80 REM Start lead boiler when system enabled
90 IF {device-name}-HW-SYS-ENAB = ON AND DEV > 5 THEN {device-name}-LEAD-BLR-SS = ON
100 IF DEV < -5 OR {device-name}-HW-SYS-ENAB = OFF THEN {device-name}-LEAD-BLR-SS = OFF
110 REM Stage lag boiler if deviation persists
120 IF DEV > 15 AND {device-name}-LEAD-BLR-SS = ON THEN {device-name}-LAG-BLR-SS = ON
130 IF DEV < 5 THEN {device-name}-LAG-BLR-SS = OFF
