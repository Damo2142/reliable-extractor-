REM **** Hot Water System Control
REM **** Generated by SBS Composition Engine v2
REM **** Network reads, OA enthalpy, system enable

REM **** Read outside air data ****
{device-name}-NET-OAT = {device-name}-OAT
{device-name}-NET-OAH = {device-name}-OAH

REM **** Calculate outside air enthalpy ****
{device-name}-NET-OA-ERH = ENTHALPY( {device-name}-NET-OAT , {device-name}-NET-OAH , 1 )

REM **** Calculate HW delta T ****
{device-name}-HW-DELTA-T = {device-name}-HWS-T - {device-name}-HWR-T

REM **** System enable — SWITCH with 3 degree deadband ****
REM **** Enable when OAT drops below enable SP, disable when OAT rises above SP+3 ****
A = SWITCH( A , {device-name}-NET-OAT , {device-name}-CFG-HHW-OA-ENAB-SP + 3 , {device-name}-CFG-HHW-OA-ENAB-SP )
IF A THEN STOP {device-name}-HW-SYS-ENAB ELSE START {device-name}-HW-SYS-ENAB
