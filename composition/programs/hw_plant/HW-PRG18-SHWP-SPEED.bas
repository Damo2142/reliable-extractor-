REM ======================================================================
REM  Generated by SBS Composition Engine v2
REM  {device-name} — Secondary Pump VFD Speed
REM  DP PID loop drives secondary pump speed
REM ======================================================================

REM ***** Speed from DP PID loop *****
A = {device-name}-SHWP1-SPEED
B = loop1

REM ***** Clamp to min/max *****
IF B < {device-name}-HWP-MIN-SPEED THEN B = {device-name}-HWP-MIN-SPEED
IF B > {device-name}-HWP-MAX-SPEED THEN B = {device-name}-HWP-MAX-SPEED

REM ***** Ramp speed output *****
IF {device-name}-HW-SYS-ENAB THEN {device-name}-SHWP1-SPEED = RAMP( ABS( A - B ) > 1 , A , B , 3.33 ) ELSE {device-name}-SHWP1-SPEED = 0
IF ABS( A - B ) < 1 THEN {device-name}-SHWP1-SPEED = B
{device-name}-SHWP2-SPEED = {device-name}-SHWP1-SPEED
