REM ======================================================================
REM  Generated by SBS Composition Engine v2
REM  {device-name} — HW Pump Start/Stop Control
REM ======================================================================

REM ***** Start lead pump when system enabled *****
IF {device-name}-HW-SYS-ENAB THEN START {device-name}-LEAD-HWP-SS ELSE STOP {device-name}-LEAD-HWP-SS

REM ***** Map lead/lag to physical pumps *****
IF {device-name}-LEAD-HWP = 1 THEN A = {device-name}-LEAD-HWP-SS , B = {device-name}-LAG-HWP-SS
IF {device-name}-LEAD-HWP = 2 THEN B = {device-name}-LEAD-HWP-SS , A = {device-name}-LAG-HWP-SS

REM ***** Write pump outputs *****
IF A AND NOT {device-name}-HWP1-FAIL THEN START {device-name}-HWP1-S/S ELSE STOP {device-name}-HWP1-S/S
IF B AND NOT {device-name}-HWP2-FAIL THEN START {device-name}-HWP2-S/S ELSE STOP {device-name}-HWP2-S/S

REM ***** Pump 1 failure detection — 30 sec proof *****
IF {device-name}-HWP1-S/S AND NOT {device-name}-HWP1-STS THEN C = C + INTERVAL ELSE C = 0
IF C > 30 THEN START {device-name}-HWP1-FAIL
IF {device-name}-RESET-SAFETIES THEN STOP {device-name}-HWP1-FAIL , C = 0

REM ***** Pump 2 failure detection *****
IF {device-name}-HWP2-S/S AND NOT {device-name}-HWP2-STS THEN D = D + INTERVAL ELSE D = 0
IF D > 30 THEN START {device-name}-HWP2-FAIL
IF {device-name}-RESET-SAFETIES THEN STOP {device-name}-HWP2-FAIL , D = 0

REM ***** Any pump running *****
IF {device-name}-HWP1-STS OR {device-name}-HWP2-STS THEN START {device-name}-ANY-HWP-ON ELSE STOP {device-name}-ANY-HWP-ON

REM ***** Lead pump failure — start lag *****
IF {device-name}-LEAD-HWP-FAIL AND {device-name}-HW-SYS-ENAB THEN START {device-name}-LAG-HWP-SS
IF {device-name}-LEAD-HWP = 1 THEN {device-name}-LEAD-HWP-FAIL = {device-name}-HWP1-FAIL
IF {device-name}-LEAD-HWP = 2 THEN {device-name}-LEAD-HWP-FAIL = {device-name}-HWP2-FAIL
