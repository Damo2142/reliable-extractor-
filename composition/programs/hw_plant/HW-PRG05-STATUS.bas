REM **** HW Plant System Status
REM **** Generated by SBS Composition Engine v2
REM **** HW availability, delta-T monitoring, low-flow alarm

REM **** HW Available — requires ALL of: system enabled, pump proven, supply temp > 110°F ****
IF {device-name}-HW-SYS-ENAB AND {device-name}-ANY-HWP-ON AND {device-name}-HWS-T > 110 THEN START {device-name}-HW-AVAIL ELSE STOP {device-name}-HW-AVAIL

REM **** Low delta-T alarm — if pumps running and delta-T < 5°F, possible flow issue ****
IF {device-name}-ANY-HWP-ON AND {device-name}-HW-DELTA-T < {device-name}-LOW-DELTA-T-SP AND TIME-ON( {device-name}-ANY-HWP-ON ) > 0:05:00 THEN START {device-name}-LOW-DELTA-T ELSE STOP {device-name}-LOW-DELTA-T
