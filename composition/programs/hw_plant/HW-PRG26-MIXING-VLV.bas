REM **** 3-Way Hot Water Mixing Valve Control
REM **** Generated by SBS Composition Engine v2
REM **** Pattern: Lordstown PRG6 by S. Boyce

REM **** Setpoint tracks active HWS temp setpoint ****
{device-name}-HWV-PID-SP = {device-name}-ACT-HWS-TEMP-SP

REM **** Modulate mixing valve from PID loop — RAMP for smooth control ****
A = {device-name}-HW-MIXING-VLV
B = loop2
IF {device-name}-HW-SYS-ENAB THEN {device-name}-HW-MIXING-VLV = RAMP( ABS( A - B ) > 1 , A , B , 1.6667 ) ELSE {device-name}-HW-MIXING-VLV = 0
IF ABS( A - B ) < 1 THEN {device-name}-HW-MIXING-VLV = B

REM **** Clamp valve position ****
{device-name}-HW-MIXING-VLV = LIMIT( {device-name}-HW-MIXING-VLV , 0 , 100 )
