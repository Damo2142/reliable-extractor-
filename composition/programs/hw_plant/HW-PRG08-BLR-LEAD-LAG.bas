REM **** Boiler Lead/Lag Rotation
REM **** Generated by SBS Composition Engine v2
REM **** Schedule driven with automatic failure swap

REM **** Read lead boiler from rotation schedule ****
{device-name}-LEAD-BLR = {device-name}-BLR-LEAD-SCHED

REM **** Force swap if scheduled lead has failed ****
IF {device-name}-LEAD-BLR < 2 AND {device-name}-BLR1-FAIL THEN {device-name}-LEAD-BLR = 2
IF {device-name}-LEAD-BLR >= 2 AND {device-name}-BLR2-FAIL THEN {device-name}-LEAD-BLR = 1

REM **** Clamp to valid range ****
{device-name}-LEAD-BLR = LIMIT( {device-name}-LEAD-BLR , 1 , 2 )
