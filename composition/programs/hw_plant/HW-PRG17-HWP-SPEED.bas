REM ======================================================================
REM  Generated by SBS Composition Engine v2
REM  {device-name} — Pump VFD Speed Control
REM  DP PID loop drives pump speed
REM ======================================================================

REM ***** Average DP sensors *****
{device-name}-AVG-DP = ( {device-name}-HW-PRESS1 + {device-name}-HW-PRESS2 ) / 2

REM ***** Speed from DP PID loop *****
A = {device-name}-HWP1-SPEED
B = loop1

REM ***** Clamp to min/max *****
IF B < {device-name}-HWP-MIN-SPEED THEN B = {device-name}-HWP-MIN-SPEED
IF B > {device-name}-HWP-MAX-SPEED THEN B = {device-name}-HWP-MAX-SPEED

REM ***** Ramp speed output *****
IF {device-name}-LEAD-HWP-SS THEN {device-name}-HWP1-SPEED = RAMP( ABS( A - B ) > 1 , A , B , 3.33 ) ELSE {device-name}-HWP1-SPEED = 0
IF ABS( A - B ) < 1 THEN {device-name}-HWP1-SPEED = B

REM ***** Same for pump 2 *****
IF {device-name}-LAG-HWP-SS THEN {device-name}-HWP2-SPEED = {device-name}-HWP1-SPEED ELSE {device-name}-HWP2-SPEED = 0
