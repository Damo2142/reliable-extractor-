REM **** Boiler Firing Rate Control
REM **** Generated by SBS Composition Engine v2
REM **** Per-boiler fire rate with startup sequence and voltage conversion

REM **** Boiler supply temp setpoint ****
{device-name}-BLR-SUPPLY-STPNT = {device-name}-ACT-HWS-TEMP-SP

REM **** === Boiler #1 === ****
{device-name}-B1-DEV = {device-name}-BLR-SUPPLY-STPNT - {device-name}-HWS-T

REM **** B1 Enable from SWITCH on deviation with start/stop thresholds ****
{device-name}-BLR1-SS = SWITCH( {device-name}-BLR1-SS , {device-name}-B1-DEV , {device-name}-B1-STOP , {device-name}-B1-START )

REM **** B1 Fire rate — skip if not running ****
IF NOT {device-name}-BLR1-S/S THEN {device-name}-BLR1-MOD = 0 , END

REM **** B1 Startup sequence: purge delay at 0, then low fire, then modulate ****
IF TIME-ON( {device-name}-BLR1-S/S ) < {device-name}-BLR-PURGE-DELAY THEN {device-name}-BLR1-MOD = 0 , END
IF TIME-ON( {device-name}-BLR1-S/S ) < {device-name}-BLR-PURGE-DELAY + 30 THEN {device-name}-BLR1-MOD = {device-name}-B1-LOW-FIRE * {device-name}-B1-VOLT-BURN%-CNV / 100 , END

REM **** B1 Normal modulation — SLIDE deviation to fire range ****
C = SLIDE( {device-name}-B1-DEV , 0 , 20 , {device-name}-B1-LOW-FIRE , {device-name}-B1-HI-FIRE )
{device-name}-BLR1-MOD = C * {device-name}-B1-VOLT-BURN%-CNV / 100
{device-name}-BLR1-MOD = LIMIT( {device-name}-BLR1-MOD , 0 , 10 )

REM **** === Boiler #2 === ****
{device-name}-B2-DEV = {device-name}-BLR-SUPPLY-STPNT - {device-name}-HWS-T

REM **** B2 Enable ****
{device-name}-BLR2-SS = SWITCH( {device-name}-BLR2-SS , {device-name}-B2-DEV , {device-name}-B2-STOP , {device-name}-B2-START )

REM **** B2 Fire rate ****
IF NOT {device-name}-BLR2-S/S THEN {device-name}-BLR2-MOD = 0 , END

REM **** B2 Startup sequence ****
IF TIME-ON( {device-name}-BLR2-S/S ) < {device-name}-BLR-PURGE-DELAY THEN {device-name}-BLR2-MOD = 0 , END
IF TIME-ON( {device-name}-BLR2-S/S ) < {device-name}-BLR-PURGE-DELAY + 30 THEN {device-name}-BLR2-MOD = {device-name}-B2-LOW-FIRE * {device-name}-B2-VOLT-BURN%-CNV / 100 , END

REM **** B2 Normal modulation ****
D = SLIDE( {device-name}-B2-DEV , 0 , 20 , {device-name}-B2-LOW-FIRE , {device-name}-B2-HI-FIRE )
{device-name}-BLR2-MOD = D * {device-name}-B2-VOLT-BURN%-CNV / 100
{device-name}-BLR2-MOD = LIMIT( {device-name}-BLR2-MOD , 0 , 10 )

REM **** RELINQUISH outputs when boiler off ****
IF NOT {device-name}-BLR1-S/S THEN RELINQUISH {device-name}-BLR1-MOD
IF NOT {device-name}-BLR2-S/S THEN RELINQUISH {device-name}-BLR2-MOD
