{
  "family": "AHU-VAV",
  "description": "Standard AHU with VAV distribution — Variable Air Volume Air Handling Unit",
  "version": "1.0.0",
  "notes": [
    "Row number = physical terminal number on Reliable Controls hardware",
    "If a feature is not selected, the row is LEFT EMPTY — never shift points",
    "All inputs are universal — range code determines AI vs BI behavior",
    "All outputs are universal — range code determines AO vs BO behavior",
    "MPS base: 12 inputs / 8 outputs. Expansion at row 13 (inputs) / row 9 (outputs)",
    "Based on A201 reference controller + SBS Point Dictionary"
  ],
  "inputs": {
    "1":  { "name": "SF-S",         "type": "BI", "range": "Off/On",              "desc": "Supply Fan Status",                     "module": "core",         "always": true },
    "2":  { "name": "RF-S",         "type": "BI", "range": "Off/On",              "desc": "Return/Exhaust Fan Status",             "module": "fan-rf",       "alt_name": "EF-S", "alt_module": "fan-ef" },
    "3":  { "name": "LTC",          "type": "BI", "range": "Normal/Alarm",        "desc": "Low Temperature Cutout (Freeze Stat)",  "module": "safe-freeze",  "always": true },
    "4":  { "name": "SMOKE",        "type": "BI", "range": "Normal/Alarm",        "desc": "Duct Smoke Detector",                   "module": "safe-smoke",   "always": true },
    "5":  { "name": "MAT",          "type": "AI", "range": "10K -40->250",        "desc": "Mixed Air Temperature",                 "module": "core",         "always": true,  "units": "°F" },
    "6":  { "name": "SAT",          "type": "AI", "range": "10K -40->250",        "desc": "Supply Air Temperature",                "module": "core",         "always": true,  "units": "°F" },
    "7":  { "name": "RAT",          "type": "AI", "range": "10K -40->250",        "desc": "Return Air Temperature",                "module": "core",         "always": true,  "units": "°F" },
    "8":  { "name": "HWC-DAT",      "type": "AI", "range": "10K -40->250",        "desc": "Heating Coil Discharge Air Temp",       "module": "htg-hw",       "alt_name": "PH-LAT", "alt_module": "ph-hw", "units": "°F" },
    "9":  { "name": "RA-CO2",       "type": "AI", "range": "Table:CO2",           "desc": "Return Air CO2",                        "module": "dcv-co2",      "units": "ppm" },
    "10": { "name": "RAH",          "type": "AI", "range": "0->100% (0-10V)",     "desc": "Return Air Humidity",                   "module": "hum",          "units": "%" },
    "11": { "name": "ERW-EA-EAT",   "type": "AI", "range": "10K -40->250",        "desc": "ERW Exhaust Air Entering Temp",         "module": "erw",          "units": "°F" },
    "12": { "name": "SA-DSP",       "type": "AI", "range": "Table:SA-DSP",        "desc": "Duct Static Pressure (primary)",        "module": "core",         "always": true,  "units": "WC" },

    "13": { "name": "SA-HPS",       "type": "BI", "range": "Normal/Alarm",        "desc": "Supply Air High Static Switch",         "module": "safe-hi-static", "_note": "Expansion 1 starts here on MPS" },
    "14": { "name": "BLDG-PRESS",   "type": "AI", "range": "Table:BLDG-P",        "desc": "Building Static Pressure",              "module": "fan-rf-bldg-p", "units": "WC" },
    "15": { "name": "EA-HPS",       "type": "BI", "range": "Normal/Alarm",        "desc": "Exhaust Air High Static Switch",        "module": "fan-ef" },
    "16": { "name": "SA-DSP-Z2",    "type": "AI", "range": "Table:SA-DSP",        "desc": "Duct Static Pressure Zone 2",           "module": "dsp-multi",    "units": "WC" },
    "17": { "name": "SA-DSP-Z3",    "type": "AI", "range": "Table:SA-DSP",        "desc": "Duct Static Pressure Zone 3",           "module": "dsp-multi",    "units": "WC" },
    "18": { "name": "ZN-RH",        "type": "AI", "range": "0->100% (0-10V)",     "desc": "Zone Humidity (for dehumid)",            "module": "dehum-sc",     "units": "%" },
    "19": { "name": "MA-FILT",      "type": "BI", "range": "Clean/Dirty",         "desc": "Mixed Air Filter DP Switch",            "module": "safe-filter",  "always": true },
    "20": { "name": "BLDG-PRESS-2", "type": "AI", "range": "Table:BLDG-P",        "desc": "Building Pressure Zone 2",              "module": "fan-rf-bldg-p","units": "WC" },
    "21": { "name": "OA-CFM",       "type": "AI", "range": "Table:OA-VEL",        "desc": "Outside Airflow (velocity/station)",     "module": "vent-ams",     "alt_module": "vent-fix", "units": "CFM" },
    "22": { "name": "EA-CFM",       "type": "AI", "range": "Table:EA-VEL",        "desc": "Exhaust Airflow",                       "module": "fan-ef",       "units": "CFM" },
    "23": { "name": "EA-DMP-ES",    "type": "BI", "range": "Close/Open",          "desc": "Exhaust Damper End Switch",              "module": "dmp-oa-ra-ea" },
    "24": { "name": "ERW-STATUS",   "type": "BI", "range": "Off/On",              "desc": "Energy Recovery Wheel Status",           "module": "erw" },

    "25": { "name": "OA-FILT",      "type": "BI", "range": "Clean/Dirty",         "desc": "OA Pre-Filter DP Switch",               "module": "safe-filter-oa" },
    "26": { "name": "FINAL-FILT",   "type": "BI", "range": "Clean/Dirty",         "desc": "Final Filter DP Switch",                "module": "safe-filter-final" },
    "27": { "name": "EA-FILT",      "type": "BI", "range": "Clean/Dirty",         "desc": "Exhaust Filter DP Switch",              "module": "safe-filter-ea" },
    "28": { "name": "RLF-S",        "type": "BI", "range": "Off/On",              "desc": "Relief Fan Status",                     "module": "fan-rlf" },
    "29": { "name": "ERW-OA-DAT",   "type": "AI", "range": "10K -40->250",        "desc": "ERW OA Leaving Air Temp",               "module": "erw",          "units": "°F" },
    "30": { "name": "ERW-EA-DAT",   "type": "AI", "range": "10K -40->250",        "desc": "ERW Exhaust Leaving Air Temp",           "module": "erw",          "units": "°F" },
    "31": { "name": "HWC-SUPW-T",   "type": "AI", "range": "10K -40->250",        "desc": "HW Coil Supply Water Temp",             "module": "htg-hw",       "units": "°F" },
    "32": { "name": "HWC-RETW-T",   "type": "AI", "range": "10K -40->250",        "desc": "HW Coil Return Water Temp",             "module": "htg-hw",       "units": "°F" },
    "33": { "name": "CHWC-SUPW-T",  "type": "AI", "range": "10K -40->250",        "desc": "CHW Coil Supply Water Temp",            "module": "clg-chw",      "units": "°F" },
    "34": { "name": "CHWC-RETW-T",  "type": "AI", "range": "10K -40->250",        "desc": "CHW Coil Return Water Temp",            "module": "clg-chw",      "units": "°F" },
    "35": { "name": "PH-EAT",       "type": "AI", "range": "10K -40->250",        "desc": "Preheat Entering Air Temp",             "module": "ph-hw",        "units": "°F" },
    "36": { "name": "COND-OVF",     "type": "BI", "range": "Normal/Alarm",        "desc": "Condensate Overflow Switch",            "module": "safe-cond-ovf" },

    "37": { "name": "HUM-STS",      "type": "BI", "range": "Off/On",              "desc": "Humidifier Status",                     "module": "hum-stm" },
    "38": { "name": "FIRE-SD",      "type": "BI", "range": "Normal/Alarm",        "desc": "Fire Shutdown Contact",                 "module": "safe-fire-sd" },
    "39": { "name": "PH-SUPW-T",    "type": "AI", "range": "10K -40->250",        "desc": "Preheat Coil Supply Water Temp",        "module": "ph-hw",        "units": "°F" },
    "40": { "name": "PH-RETW-T",    "type": "AI", "range": "10K -40->250",        "desc": "Preheat Coil Return Water Temp",        "module": "ph-hw",        "units": "°F" },
    "41": { "name": "FREEZE-DP",    "type": "BI", "range": "Normal/Alarm",        "desc": "Freeze Stat DP (coil face)",            "module": "safe-freeze-dp" },
    "42": { "name": "DX-HP",        "type": "BI", "range": "Normal/Alarm",        "desc": "DX High Pressure Switch",               "module": "clg-dx" },
    "43": { "name": "DX-LP",        "type": "BI", "range": "Normal/Alarm",        "desc": "DX Low Pressure Switch",                "module": "clg-dx" },
    "44": { "name": "GAS-PRSR",     "type": "BI", "range": "Normal/Alarm",        "desc": "Gas Pressure Switch",                   "module": "htg-gas" }
  },

  "outputs": {
    "1":  { "name": "OAD",            "type": "AO", "range": "0->100%", "min_v": 2.0,  "max_v": 10.0, "desc": "Outside Air Damper",              "module": "dmp-oa",      "always": true },
    "2":  { "name": "RAD",            "type": "AO", "range": "0->100%", "min_v": 10.0, "max_v": 2.0,  "desc": "Return Air Damper (reverse)",     "module": "dmp-oa-ra",   "reverse": true },
    "3":  { "name": "EAD",            "type": "AO", "range": "0->100%", "min_v": 2.0,  "max_v": 10.0, "desc": "Exhaust Air Damper",              "module": "dmp-oa-ra-ea" },
    "4":  { "name": "HW-VLV",         "type": "AO", "range": "0->100%", "min_v": 10.0, "max_v": 2.0,  "desc": "Hot Water Valve (reverse)",       "module": "htg-hw",      "reverse": true },
    "5":  { "name": "CHW-VLV",        "type": "AO", "range": "0->100%", "min_v": 2.0,  "max_v": 10.0, "desc": "Chilled Water Valve",             "module": "clg-chw" },
    "6":  { "name": "ERW-OA-BYP-DMP", "type": "AO", "range": "0->100%", "min_v": 2.0,  "max_v": 10.0, "desc": "ERW OA Bypass Damper",            "module": "erw" },
    "7":  { "name": "ERW-EA-BYP-DMP", "type": "AO", "range": "0->100%", "min_v": 2.0,  "max_v": 10.0, "desc": "ERW EA Bypass Damper",            "module": "erw" },
    "8":  { "name": "PH-VLV",         "type": "AO", "range": "0->100%", "min_v": 10.0, "max_v": 2.0,  "desc": "Preheat Valve (reverse)",         "module": "ph-hw",       "reverse": true },

    "9":  { "name": "SF",             "type": "BO", "range": "Stop/Start",                             "desc": "Supply Fan Command",              "module": "core",        "always": true, "_note": "MPS output expansion starts at row 9 (outputs 1-8 on base)" },
    "10": { "name": "SF-VFD-SPD",     "type": "AO", "range": "0->100%", "min_v": 0.0,  "max_v": 10.0, "desc": "Supply Fan VFD Speed",            "module": "fan-sf-vfd" },
    "11": { "name": "RF",             "type": "BO", "range": "Stop/Start",                             "desc": "Return/Exhaust Fan Command",      "module": "fan-rf",      "alt_name": "EF", "alt_module": "fan-ef" },
    "12": { "name": "RF-VFD-SPD",     "type": "AO", "range": "0->100%", "min_v": 0.0,  "max_v": 10.0, "desc": "Return/Exhaust Fan VFD Speed",    "module": "fan-rf-vfd",  "alt_name": "EF-VFD-SPD", "alt_module": "fan-ef-vfd" },
    "13": { "name": "ERW",            "type": "BO", "range": "Stop/Start",                             "desc": "Energy Recovery Wheel Command",   "module": "erw" },
    "14": { "name": "RLF",            "type": "BO", "range": "Stop/Start",                             "desc": "Relief Fan Command",              "module": "fan-rlf" },
    "15": { "name": "RLF-VFD-SPD",    "type": "AO", "range": "0->100%", "min_v": 0.0,  "max_v": 10.0, "desc": "Relief Fan VFD Speed",            "module": "fan-rlf-vfd" },
    "16": { "name": "HUM",            "type": "AO", "range": "0->100%", "min_v": 2.0,  "max_v": 10.0, "desc": "Humidifier Output",               "module": "hum-stm" },
    "17": { "name": "PH-PMP",         "type": "BO", "range": "Stop/Start",                             "desc": "Preheat Pump Command",            "module": "ph-hw-pump" },
    "18": { "name": "HW-PMP",         "type": "BO", "range": "Stop/Start",                             "desc": "HW Coil Pump Command",            "module": "htg-hw-pump" },
    "19": { "name": "CHW-PMP",        "type": "BO", "range": "Stop/Start",                             "desc": "CHW Coil Pump Command",           "module": "clg-chw-pump" },
    "20": { "name": "DX-COMP-1",      "type": "BO", "range": "Stop/Start",                             "desc": "DX Compressor Stage 1",           "module": "clg-dx" },
    "21": { "name": "DX-COMP-2",      "type": "BO", "range": "Stop/Start",                             "desc": "DX Compressor Stage 2",           "module": "clg-dx-2" },
    "22": { "name": "ELEC-HTR-1",     "type": "BO", "range": "Stop/Start",                             "desc": "Electric Heater Stage 1",         "module": "htg-elec" },
    "23": { "name": "ELEC-HTR-2",     "type": "BO", "range": "Stop/Start",                             "desc": "Electric Heater Stage 2",         "module": "htg-elec-2" },
    "24": { "name": "ELEC-HTR-3",     "type": "BO", "range": "Stop/Start",                             "desc": "Electric Heater Stage 3",         "module": "htg-elec-3" },
    "25": { "name": "GAS-VLV",        "type": "BO", "range": "Stop/Start",                             "desc": "Gas Valve (modulating or staged)", "module": "htg-gas" },
    "26": { "name": "ISO-DMP",        "type": "BO", "range": "Close/Open",                             "desc": "Isolation Damper",                "module": "dmp-iso" },
    "27": { "name": "DX-VFD-SPD",     "type": "AO", "range": "0->100%", "min_v": 0.0,  "max_v": 10.0, "desc": "DX VFD Compressor Speed",         "module": "clg-dx-vfd" },
    "28": { "name": "ELEC-SCR",       "type": "AO", "range": "0->100%", "min_v": 0.0,  "max_v": 10.0, "desc": "Electric Heat SCR (modulating)",   "module": "htg-elec-scr" },
    "29": { "name": "GAS-MOD",        "type": "AO", "range": "0->100%", "min_v": 2.0,  "max_v": 10.0, "desc": "Gas Heat Modulating Output",       "module": "htg-gas-mod" }
  },

  "controller_selection": {
    "description": "Highest occupied input/output row determines base controller + expansion boards needed",
    "base_controllers": [
      { "model": "MPS",  "base_inputs": 12, "base_outputs": 8, "max_expansion": 7, "expansion_module": "MPP-IO-U", "expansion_inputs": 12, "expansion_outputs": 8, "notes": "Primary AHU controller" },
      { "model": "MPWS", "base_inputs": 12, "base_outputs": 8, "max_expansion": 7, "expansion_module": "MPP-IO-U", "expansion_inputs": 12, "expansion_outputs": 8, "notes": "MPS with web server" },
      { "model": "MP2",  "base_inputs": 12, "base_outputs": 8, "max_expansion": 3, "expansion_module": "MPP-IO-U", "expansion_inputs": 12, "expansion_outputs": 8, "notes": "Midsize, limited expansion" }
    ],
    "logic": "Count highest occupied input row and highest occupied output row. Base controller covers first N. Each expansion adds more. Select smallest config that fits."
  }
}
